# Database configuration
DB_URI=mongodb://localhost:27017/your_database_name

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Paystack Keys
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Google Gemini API Key
# Get your API key from https://ai.google.dev/
# Required for the questionnaire document upload feature
# NOTE: Make sure to enable the 'fileManager.files' scope for your API key
# so it can process document files properly
GEMINI_API_KEY=your_gemini_api_key

# Database security key
DB_KEY=your_db_key

# Redis Configuration
# Redis URL format: redis://username:password@host:port
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# For Docker Compose, use "redis" as the hostname.
# For local development without Docker, use "localhost" or "127.0.0.1"

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Pricing Configuration
# Tiered pricing model: BR + 15(n) + 250
# Base rate increases by BASE_RATE_INCREMENT for every TIER_SIZE participants
PRICING_INITIAL_BASE_RATE=3000
PRICING_PARTICIPANT_RATE=15
PRICING_FIXED_COST=250
PRICING_BASE_RATE_INCREMENT=1000
PRICING_TIER_SIZE=100

# ---------------------------------------------------------------------------
# KYC — BE-01: Phone + SMS OTP Infrastructure
# ---------------------------------------------------------------------------

# --- Twilio (recommended) ---
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Generic SMS Provider (alternative to Twilio) ---
# Only used if TWILIO_ACCOUNT_SID is not set
# API key for the HTTP SMS provider
SMS_PROVIDER_API_KEY=
# Base URL of the SMS provider HTTP API (no trailing slash)
# Example: https://api.termii.com
SMS_PROVIDER_BASE_URL=

# How long (in minutes) an issued OTP remains valid before expiring
OTP_EXPIRY_MINUTES=10



# ---------------------------------------------------------------------------
# KYC — BE-07: Sensitive Layers Encryption
# ---------------------------------------------------------------------------

# 64 hex characters (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED — server will refuse to start if this is missing or wrong length
KYC_FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# KYC — BE-08: NDPR Data Retention
# ---------------------------------------------------------------------------

# Number of days to retain KYC data before it is eligible for erasure
KYC_DATA_RETENTION_DAYS=730

# ---------------------------------------------------------------------------
# KYC — BE-02: Shared Sign-Up + Email OTP
# ---------------------------------------------------------------------------

# SMTP configuration for KYC email OTPs (academic, work, and org email verification)
# If not set, falls back to EMAIL_USER / EMAIL_PASSWORD above
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The "from" address on KYC verification emails
SMTP_FROM=no-reply@surveytools.ng

# ---------------------------------------------------------------------------
# KYC — BE-06: Progressive Profiling (corrected value)
# ---------------------------------------------------------------------------

# Number of surveys a respondent must complete before Layer 2 is unlocked
# Product doc specifies: Layer 2 unlocks after 1st survey; Layers 3-5 after 5th survey
KYC_LAYER2_SURVEY_THRESHOLD=1
# Number of surveys before Layers 3 & 4 become available
KYC_SENSITIVE_LAYERS_SURVEY_THRESHOLD=5

# ---------------------------------------------------------------------------
# KYC — Password Reset OTP (Phase 4 change)
# ---------------------------------------------------------------------------

# Password reset codes expire at the same rate as phone/email OTPs (OTP_EXPIRY_MINUTES above)
# No additional env var needed — reuses OTP_EXPIRY_MINUTES

# ---------------------------------------------------------------------------
# KYC — Email Domain Restriction
# ---------------------------------------------------------------------------

# The domain enforced for academic (student) email OTP verification
# Default: .edu.ng — change only if your institution uses a different academic domain
KYC_STUDENT_EMAIL_DOMAIN=.edu.ng
