    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:5000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "missionProgressId",
            "value": "ID_HERE",
            "type": "string"
        },
        {
            "key": "surveyId",
            "value": "SURVEY_ID_HERE",
            "type": "string"
        },
        {
            "key": "questionId",
            "value": "PRIMARY_QUESTION_ID",
