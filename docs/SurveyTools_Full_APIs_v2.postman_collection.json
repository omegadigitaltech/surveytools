                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPass123!\",\n  \"confirmPassword\": \"NewPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reset-password"
              ]
            }
          }
        }
